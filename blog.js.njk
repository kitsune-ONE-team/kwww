---
# vim: set ft=javascript:
permalink: blog.js
---

async function blog(edit) {
    var hash = window.location.hash.slice(1);
    if (!hash.startsWith('posts/'))
        return;

    const content = document.getElementById('k-content')
    content.innerHTML = '';

    const response = await fetch(`{{config.api}}/blog/?url=${hash}`, {
        credentials: 'include',
    });
    if (response.ok) {
        const data = await response.json();
        const url = !edit ? `/edit/#${hash}` : `/#${hash}`
        content.innerHTML = `
<div class="k-section-blog k-bg-dark">
    <h2 class="k-heading">
        ${data.post.title}
        <a id="k-edit" class="${data.readonly ? 'k-hidden' : ''}" href="${url}">
            <i class="fas ${!edit ? 'fa-pen' : 'fa-floppy-disk'}"></i>
        </a>
        <span class="k-right">
            ${strftime('%Y-%m-%d %H:%M', new Date(data.post.created))}
        </span>
    </h2>
    <div class="k-blog-post" id="k-editable">${data.post.content}</div>
    <div class="k-clear"></div>
</div>
        `;
        content.querySelectorAll('img').forEach(img => {
            if (!img.src)
                return;
            const url = new URL(img.src);
            img.src = 'https://den.kitsune.one' + url.pathname;
        })
    } else {
        document.location.href = `/404.html#${hash}`;
    }
}
